// The core entities are deliberately the ones the full yard-management system will
// need, so this work carries forward rather than being thrown away.
//
// SQLite for now: zero setup, real migrations, one line to switch to Postgres.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A photographed sheet, from upload to commit.
model Sheet {
  id        String   @id @default(cuid())
  photoPath String
  /// queued | extracting | needs_review | ready | failed | committed
  status    String   @default("queued")
  /// The model's transcription, stored verbatim as JSON text and never edited.
  /// Kept beside the corrected values: that pairing is what tells us later how
  /// well the harness is doing on real sheets.
  rawExtraction String?
  /// The flags raised by validation, as JSON text.
  flags         String?
  /// The extraction after a person corrected it. The raw one above is never
  /// touched: keeping both is what lets us measure the harness on real paper,
  /// and what makes the audit trail mean anything.
  correctedExtraction String?
  /// The independent second reading, taken only when something blocking is
  /// open, and what it concluded. `secondAgreed = true` means both passes read
  /// the same thing, so the error is probably on the paper rather than in the
  /// reading — which is what a reviewer needs to know before they start looking.
  secondExtraction String?
  secondAgreed     Boolean?
  secondDiffs      String?
  error         String?
  createdAt     DateTime  @default(now())
  committedAt   DateTime?
  /// Photos are deleted after the retention window; the extraction is kept.
  photoDeletedAt DateTime?

  event       WeighingEvent?
  corrections Correction[]

  @@index([status])
  @@index([createdAt])
}

/// One purchase: a tarjeta from the small scale, or a truck load on a comprobante.
model WeighingEvent {
  id      String @id @default(cuid())
  sheetId String @unique
  sheet   Sheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  /// tarjeta | comprobante
  kind String
  /// The card or receipt number. Pre-printed, so it identifies the paper.
  folio String?
  /// ISO date. Every committed document has one: all reporting is keyed on it.
  date         String?
  counterparty String?

  /// Comprobante only: the truck weights, and the material of the whole load.
  truckGross     Float?
  truckTare      Float?
  truckNet       Float?
  truckUnit      String?
  deductions     Float?
  finalNet       Float?
  bulkMaterialId String?

  /// What the load came to, what was actually paid, and what is still owed.
  /// A purchase and a payment are different events on this paperwork.
  total Float?
  paid  Float?
  owed  Float?

  lines Line[]

  @@index([date])
  @@index([folio])
}

/// One material weighed within an event. Tarjetas have several; a comprobante
/// buys a whole truck of one material and has none.
model Line {
  id      String        @id @default(cuid())
  eventId String
  event   WeighingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  position Int
  /// Exactly as written on the paper: "chat", "grues", "Radiador ALU".
  materialRaw String
  materialId  String?
  material    Material? @relation(fields: [materialId], references: [id])

  quantity  Float?
  unit      String?
  unitPrice Float?
  amount    Float?
  note      String?

  @@index([eventId])
  @@index([materialId])
}

model Material {
  id   String @id
  name String @unique
  /// kg | lb | qq | t — the unit this material is bought in. The paper almost
  /// never says, so this is where that knowledge lives.
  unit String
  /// What the yard pays per unit, in USD.
  price Float
  /// The band a written price may fall in before the line is flagged. Prices are
  /// negotiated per load, so a fixed price would flag half the honest lines.
  priceMin Float
  priceMax Float
  active   Boolean @default(true)
  position Int     @default(0)

  aliases Alias[]
  lines   Line[]
}

/// How a material is actually written on sheets.
model Alias {
  id         Int      @id @default(autoincrement())
  text       String   @unique
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

/// Every edit a person makes to what the model read. The audit trail is the
/// reason a yard can trust this at all.
model Correction {
  id      String @id @default(cuid())
  sheetId String
  sheet   Sheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  field     String
  fromValue String?
  toValue   String?
  user      String?
  createdAt DateTime @default(now())

  @@index([sheetId])
}

/// Single row, id = 1.
model Config {
  id Int @id @default(1)
  /// Amounts at the counter are truncated down to a multiple of this.
  cashRounding Float @default(0.05)
  /// Band for the price a truck load implies, where no unit price is written.
  bulkPriceMin Float @default(0.12)
  bulkPriceMax Float @default(0.45)
  currency           String @default("USD")
  photoRetentionDays Int    @default(90)
  /// Default UI language: es | en
  language String @default("es")
}

# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Where photos and the SQLite database are written
DATA_DIR=./data
# (path is relative to prisma/, which is where the schema lives)
DATABASE_URL="file:../data/app.db"

# Set to "stub" to replay the dataset's ground truth instead of calling the
# model. Every screen it feeds says so. Anything else calls the model.
EXTRACTOR=

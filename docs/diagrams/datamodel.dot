digraph data {
  rankdir=TB; bgcolor="white"; nodesep=0.4; ranksep=0.5;
  node [fontname="DejaVu Sans", fontsize=10, shape=record, style=filled, fillcolor="#eef2f6", color="#7a8899"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#5a6878"];

  Sheet [label="{Document|photo_path\nstatus\nraw_extraction (JSON, immutable)\nflags\ncreated_at}"];
  Event [label="{WeighingEvent|kind: tarjeta | comprobante\nfolio (card or receipt number)\ndate\ncounterparty\ntruck: gross / tare / net\ndeductions}"];
  Line  [label="{Line|material_raw\nmaterial_id\nquantity · unit\nprice · amount}"];
  Mat   [label="{Material|name\nunit\nprice\nband: min – max}"];
  Alias [label="{Alias|text\nmaterial_id}"];
  Corr  [label="{Correction|field\nfrom → to\nusuario · date y hora}", fillcolor="#fff8e1", color="#c9a227"];
  Pago  [label="{Settlement|total\npayments: cash · deposit · transfer\nbalance owed}", fillcolor="#dcecdf", color="#5f8f6c"];
  Cfg   [label="{Config|cash rounding = 0,05\ntruck price band: 0,12 – 0,45\nphotos: 90 days}"];

  Sheet -> Event [label=" 1:1"];
  Event -> Line [label=" 1:N (tarjetas only)"];
  Event -> Pago [label=" 1:1"];
  Line -> Mat [label=" N:1 (resolved)"];
  Mat -> Alias [label=" 1:N"];
  Sheet -> Corr [label=" 1:N  audit trail"];
}
